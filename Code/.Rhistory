all.predictions_true.eachShuffle=rbind(all.predictions_true.eachShuffle,all.predictions_true.temp)
rm(all.predictions_true.temp)
}
all.predictions_true.allShuffles[[ishuffle]]=all.predictions_true.eachShuffle
rm(all.predictions_true.eachShuffle)
}
# write file
save(all.predictions_true.allShuffles,file=out.file)
}
}
}
}
}
stopCluster(cl)
dim(settings.all)
settings
dim( settings.all %>% dplyr::filter(event_type=='Options Appear'))
View(settings.all)
settings.all=read.xlsx(analysis.file,sheet='IndividualParticipants')
# add: double by having two standardizations (this applies to everything, so don't want to manually code it)
settings.all=rbind(settings.all%>% dplyr::mutate(standardization='WithinEachParticipant')) #,
unique(settings.all$analysis.type)
