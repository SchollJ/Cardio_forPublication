split.blockIDs=split(df.forBlockIDs$block_number,cut(df.forBlockIDs$block_number,breaks=n.folds,labels=FALSE))
folds=list()
for (i in 1:n.folds){
folds[[i]] =list('test.set'= split.blockIDs[[i]],
'train.set'=setdiff(df.forBlockIDs$block_number,split.blockIDs[[i]]))
}
all.predictions_true.allShuffles=list()
for (ishuffle in names(out$shuffles)){
all.predictions_true.eachShuffle= data.frame()
for (ifold in 1:n.folds){
#print(paste('debugging',ir, isplit, ifile,out.file,ishuffle,ifold))
# train model
df.train= out$shuffles[[ishuffle]] %>% dplyr::filter(block_number %in% folds[[ifold]]$train) # remember that the y values have been shuffled, block_numbers are untouched
df.test = out$shuffles[[ishuffle]] %>% dplyr::filter(block_number %in% folds[[ifold]]$test)
# Run single-subj regression model
all.train.pars=func.singleSubReg(df.train,x.names)
# make prediction for left out data and store
all.predictions_true.temp=func.createPredictions.withinSubj(df.test,all.train.pars)
# bind predictions
all.predictions_true.eachShuffle=rbind(all.predictions_true.eachShuffle,all.predictions_true.temp)
rm(all.predictions_true.temp)
}
all.predictions_true.allShuffles[[ishuffle]]=all.predictions_true.eachShuffle
rm(all.predictions_true.eachShuffle)
}
# write file
save(all.predictions_true.allShuffles,file=out.file)
}
}
}
}
}
