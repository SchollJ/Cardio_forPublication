settings.all %>% dplyr::filter(event_type=='Options Appear') %>% dplyr::mutate(window.max=3))
# For each way of creating the regression models:
for (ir in 1:nrow(settings.all)){
print(ir)
settings=settings.all[ir,]
# selecting regressors for sdk
if (settings$sdk_measure_type=='Emotions'){
x.names= c("sdk_anger", "sdk_happy", "sdk_sad", "sdk_fear", "sdk_digust", "sdk_surprised")
} else if (settings$sdk_measure_type=='Arousal_Valence'){
x.names=c('sdk_arousal','sdk_valence')
} else{ browser()}
if (settings$y.var!='Rating'){
print('y.var not coded yet. maybe better in a different cell')
browser()
}
t.path=file.path(paste0('DecodingModels_Sdk-',settings$sdk_measure_type,
'_Event-',settings$event_type,
'_windows-',settings$window.min,
'_s-',settings$window.max,
'_s_yvar-',settings$y.var,
'_analysistype-',settings$analysis.type,
'_standardization-',settings$standardization))
for (ishuffleFolds in c('1fold','5fold','3fold')){
this.folder = file.path(paths$decoding.withinSubj.shuffleBeforeXval,t.path,paste0('ShuffledData_',ishuffleFolds))
this.df.folder= file.path(paths$decoding,t.path,'df_eachParticipant')
suppressWarnings(dir.create(this.folder,recursive=T))
# for each person
#for (it in list.files(this.df.folder)){
foreach (it = list.files(this.df.folder), .packages=c('dplyr','stringr')) %dopar% {
isub=stringr::str_split_i(it,'_',1)
df = read.csv(file.path(this.df.folder,it))
out.file=file.path(this.folder,paste0('shuffled_',ishuffleFolds,'_',isub,'.RData'))
if (!file.exists(out.file)){
n.folds=as.numeric(stringr::str_remove(ishuffleFolds,'fold'))
if (n.folds>1){
split.blockIDs=split(df$block_number,cut(df$block_number,breaks=n.folds,labels=FALSE))
} else{
split.blockIDs=list(`1`=df$block_number)
}
shuffles=list()
shuffles[['original']]=df
all.block.perms=list()
for (iperm in 1:nperm){
shuffles[[paste0('perm_',iperm)]] = df %>% dplyr::select(participant_id,block_number,contains('sdk'))
all.block.perms[[paste0('perm_',iperm)]]=list()
blocks.perm=c()
for (i in 1:n.folds){ # we're shuffling within blocks
blocks.perm=c(blocks.perm,sample(split.blockIDs[[i]],replace=F))
all.block.perms[[paste0('perm_',iperm)]]=blocks.perm
shuffles[[paste0('perm_',iperm)]] = cbind(shuffles[[paste0('perm_',iperm)]],
# take the df and arrange the rows by ordering block_numer according to blocks.perms
df %>% dplyr::arrange(match(block_number,blocks.perm)) %>% dplyr::select(contains('response.postBlock')))
}
# old code: shuffle the y-variables separately, instead we now shuffle them together
# for (iy in colnames(df %>% dplyr::select(contains('response.postBlock')))){
#   blocks.perm=c()
#   for (i in 1:n.folds){ # we're shuffling within blocks
#     blocks.perm=c(blocks.perm,sample(split.blockIDs[[i]],replace=F))
#   }
#   all.block.perms[[paste0('perm_',iperm)]][[paste0('y_',iy)]]=blocks.perm
#   shuffles[[paste0('perm_',iperm)]] = cbind(shuffles[[paste0('perm_',iperm)]],
#                                             # take the df and arrange the rows by ordering block_numer according to blocks.perms
#                                             df %>% dplyr::arrange(match(block_number,blocks.perm)) %>% dplyr::select(contains(iy)))
# }
}
# save the shuffled data
out=list()
out$shuffles=shuffles
out$all.block.perms=all.block.perms
save(out,file=out.file)
}
}
}
}
